{
  "name": "curriculum-vitae",
  "version": "1.0.0",
  "description": "One-page CV variants built from a single source of facts, rendered HTML → CSS → headless Chromium → PDF.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "node build.ts",
    "check": "tsc --noEmit && prettier --check .",
    "preview": "node scripts/preview.ts",
    "prepare": "git config core.hooksPath .githooks || echo \"note: could not set core.hooksPath; the commit-msg hook is not installed\"",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/airbugg/curriculum-vitae"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.4",
    "simple-icons": "16.29.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
