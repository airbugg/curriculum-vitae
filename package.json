{
  "name": "curriculum-vitae",
  "version": "1.0.0",
  "description": "One-page CV variants built from a single source of facts, rendered HTML → CSS → headless Chromium → PDF.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "node build.ts",
    "check": "tsc --noEmit",
    "preview": "node scripts/preview.ts",
    "lint-commits": "node scripts/lint-commits.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/airbugg/curriculum-vitae"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  }
}
